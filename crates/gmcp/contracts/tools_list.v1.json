        "required": [
          "name"
        ],
        "type": "object",
        "title": "add_mcp_serverArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "add_mcp_serverDictOutput"
      }
    },
    {
      "name": "remove_mcp_server",
      "description": "\nRemove an MCP server from the daemon's configuration.\n\nArgs:\n    name: Server name to remove\n    scope: project or global\n\nReturns:\n    Result dict with success status\n",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scope": {
            "default": "project",
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object",
        "title": "remove_mcp_serverArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "remove_mcp_serverDictOutput"
      }
    },
    {
      "name": "import_mcp_server",
      "description": "\nImport MCP servers from another project (from_project, optionally\nnarrowed by servers), a GitHub repo URL, or a natural-language query.\n",
      "inputSchema": {
        "properties": {
          "from_project": {
            "anyOf": [
