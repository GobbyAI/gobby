    {
      "name": "init_project",
      "description": "\nInitialize a new Gobby project.\n\nNote: Project initialization requires CLI access and cannot be done\nvia the MCP proxy. Use 'gobby init' command instead.\n\nArgs:\n    name: Project name\n    project_path: Path to project directory (optional)\n\nReturns:\n    Result dict with error (CLI access required)\n",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "project_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Path"
          }
        },
        "required": [
          "name"
        ],
        "type": "object",
        "title": "init_projectArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "init_projectDictOutput"
      }
    },
    {
      "name": "set_variable",
      "description": "\nSet a session or step variable. Top-level shortcut \u2014 no progressive discovery needed.\n\nArgs:\n    name: Variable name\n    value: JSON-compatible variable value\n    session_id: Session ID (accepts #N, N, UUID, or prefix)\n    scope: \"session\" (default), or \"step\" to write the agent's step workflow instance\n\nReturns:\n    Dict with ok status and stored value\n",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "scope": {
            "default": "session",
            "enum": [
              "session",
              "step"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value",
          "session_id"
        ],
        "type": "object",
        "title": "set_variableArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "set_variableDictOutput"
      }
    },
    {
      "name": "get_variable",
      "description": "\nGet session-scoped variable(s). Top-level shortcut \u2014 no progressive discovery needed.\n\nArgs:\n    session_id: Session ID (accepts #N, N, UUID, or prefix)\n    name: Variable name (omit to get all variables)\n\nReturns:\n    Dict with variable value(s)\n",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object",
        "title": "get_variableArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "get_variableDictOutput"
      }
    }
  ],
  "resultType": "complete"
