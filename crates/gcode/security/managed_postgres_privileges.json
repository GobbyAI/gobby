{
  "version": 1,
  "principal": "gobby_gcode_capability",
  "project_resolution": {
    "source": "session_user",
    "registry": "gobby_agent_auth.principal_bindings",
    "function": "gobby_agent_auth.current_project_id()",
    "overlay_function": "gobby_agent_auth.current_code_overlay_project_id()",
    "machine_function": "gobby_agent_auth.current_machine_id()",
    "read_scope": "bound project plus bound isolation overlay",
    "write_scope": "bound isolation overlay, or bound project when no overlay exists"
  },
  "relations": [
    {"relation": "projects", "operations": ["SELECT"], "columns": ["id", "name", "repo_path"], "scope_column": "id"},
    {"relation": "config_state", "operations": ["SELECT"], "columns": ["id", "revision"], "scope_note": "single global runtime configuration revision row; no per-project data"},
    {"relation": "code_indexed_projects", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "id"},
    {"relation": "code_indexed_project_states", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id", "machine_scope_column": "machine_id"},
    {"relation": "code_indexed_file_states", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id", "machine_scope_column": "machine_id"},
    {"relation": "code_indexed_files", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_symbols", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_imports", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_calls", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_inheritance", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_content_chunks", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_index_projection_cleanup_pending", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id"},
    {"relation": "code_index_prune_dirty_projects", "operations": ["SELECT", "INSERT", "UPDATE", "DELETE"], "scope_column": "project_id", "machine_scope_column": "machine_id"}
  ],
  "sequences": [
    {"sequence": "code_imports_id_seq", "operations": ["USAGE", "SELECT"]},
    {"sequence": "code_calls_id_seq", "operations": ["USAGE", "SELECT"]},
    {"sequence": "code_inheritance_id_seq", "operations": ["USAGE", "SELECT"]}
  ],
  "explicitly_denied_relations": [
    "agent_runs",
    "config_store",
    "gobby_agent_auth.principal_audit_events",
    "gobby_agent_auth.principal_bindings",
    "memories",
    "schema_migrations",
    "secret_key_material",
    "secrets",
    "sessions",
    "tasks"
  ],
  "operator_only_command_families": [
    "global status",
    "prune",
    "schema setup and migration",
    "cross-project scope resolution",
    "secret and config_store reads"
  ],
  "source_inventory": [
{"path": "crates/gcode/src/bm25_health.rs", "calls": {"query": 1, "query_one": 1}, "classification": "project-read"},
{"path": "crates/gcode/src/codewiki_facts/graph.rs", "calls": {"query": 1}, "classification": "external-non-postgresql"},
