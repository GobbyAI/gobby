From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gobby maintainers <maintainers@gobby.ai>
Date: Fri, 11 Sep 2026 00:00:00 +0000
Subject: [PATCH] allow skipping the libghostty-vt shared library

Zig compiles its own bundled libc++ to link a C++ shared library, and zig
0.15.2 cannot do that against the macOS 27.0 SDK. Add -Demit-lib-vt-shared
so a consumer that links only the static archive can skip the shared
library and never reach that sub-build. The default is unchanged.

Vendored base: c5a21edfcbc2d5b46540ad91b7980aca31f5f1f3
---
diff --git a/crates/gterminal/vendor/libghostty-vt/build.zig b/crates/gterminal/vendor/libghostty-vt/build.zig
index 8ef7701e22..a94e2bdbf2 100644
--- a/crates/gterminal/vendor/libghostty-vt/build.zig
+++ b/crates/gterminal/vendor/libghostty-vt/build.zig
@@ -114,20 +114,26 @@ pub fn build(b: *std.Build) !void {
     }
 
     // libghostty-vt
-    const libghostty_vt_shared = shared: {
-        if (config.target.result.cpu.arch.isWasm()) {
-            break :shared try buildpkg.GhosttyLibVt.initWasm(
+    //
+    // GOBBY DIVERGENCE (crates/gterminal): not upstream. The shared library is
+    // skipped under -Demit-lib-vt-shared=false; see the option definition in
+    // src/build/Config.zig for why gobby-terminal opts out.
+    if (config.emit_lib_vt_shared) {
+        const libghostty_vt_shared = shared: {
+            if (config.target.result.cpu.arch.isWasm()) {
+                break :shared try buildpkg.GhosttyLibVt.initWasm(
+                    b,
+                    &mod,
+                );
+            }
+
+            break :shared try buildpkg.GhosttyLibVt.initShared(
                 b,
                 &mod,
             );
-        }
-
-        break :shared try buildpkg.GhosttyLibVt.initShared(
-            b,
-            &mod,
-        );
-    };
-    libghostty_vt_shared.install(b.getInstallStep());
+        };
+        libghostty_vt_shared.install(b.getInstallStep());
+    }
 
     // libghostty-vt static lib
     const libghostty_vt_static = try buildpkg.GhosttyLibVt.initStatic(
diff --git a/crates/gterminal/vendor/libghostty-vt/src/build/Config.zig b/crates/gterminal/vendor/libghostty-vt/src/build/Config.zig
index 0a99473174..a168c0d8d6 100644
--- a/crates/gterminal/vendor/libghostty-vt/src/build/Config.zig
+++ b/crates/gterminal/vendor/libghostty-vt/src/build/Config.zig
@@ -53,6 +53,10 @@ emit_docs: bool = false,
 emit_exe: bool = false,
 emit_helpgen: bool = false,
 emit_lib_vt: bool = false,
+// GOBBY DIVERGENCE (crates/gterminal): not upstream. Lets a consumer that
+// links only the static archive skip the shared library. See the option
+// definition below for why.
+emit_lib_vt_shared: bool = true,
 emit_macos_app: bool = false,
 emit_terminfo: bool = false,
 emit_termcap: bool = false,
@@ -356,6 +360,23 @@ pub fn init(b: *std.Build, appVersion: []const u8, libVersion: []const u8) !Conf
         "Set defaults for a libghostty-vt-only build (disables xcframework, macOS app, and docs).",
     ) orelse false;
 
+    // GOBBY DIVERGENCE (crates/gterminal): not upstream. Zig has to compile
+    // its own bundled libc++ to link a C++ shared library, and zig 0.15.2
+    // cannot do that against the macOS 27.0 SDK: it builds libc++ with
+    // -std=c++23, which makes clang answer __has_feature(modules) with 1, so
+    // that SDK's math.h hands INFINITY and NAN to <float.h> through
+    // __need_infinity_nan and compiles out its own `#define INFINITY
+    // HUGE_VALF` -- and zig 0.15.2's bundled float.h knows nothing about
+    // __need_infinity_nan. The static archive never links, so it builds fine.
+    // gobby-terminal's build.rs consumes only the static archive on every
+    // platform, so it opts out and never reaches the broken sub-build.
+    // Default stays true, which is upstream's behavior.
+    config.emit_lib_vt_shared = b.option(
+        bool,
+        "emit-lib-vt-shared",
+        "Build and install the libghostty-vt shared library alongside the static one.",
+    ) orelse true;
+
     config.emit_exe = b.option(
         bool,
         "emit-exe",
