{
  "uid": "gobby-daemon-health",
  "title": "Gobby Daemon Health",
  "description": "Database saturation, MCP and HTTP latency, daemon uptime, and error-log rate scraped from the daemon's /api/admin/metrics endpoint.",
  "tags": [
    "gobby",
    "observability"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Database saturation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pool acquire wait p95",
      "description": "95th percentile wait to acquire a PostgreSQL pool connection. A rising p95 during spawn_agent is the pool, not the caller.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(database_pool_acquire_wait_seconds_bucket[5m])))",
          "legendFormat": "pool acquire p95",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool waiters and executor queue depth",
      "description": "Callers blocked on a pool connection and submissions queued behind the database executor. Both non-zero means saturation, not slow queries.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "database_pool_waiting",
          "legendFormat": "pool waiting",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "database_executor_queued",
          "legendFormat": "executor queued",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "database_executor_active",
          "legendFormat": "executor active",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "database_pool_available",
          "legendFormat": "pool available",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Executor oldest queue age",
      "description": "Age of the oldest queued database executor submission. This is the series that crosses an MCP or HTTP client timeout first.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "database_executor_oldest_queue_age_seconds",
          "legendFormat": "oldest queued",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Executor queue wait p95",
      "description": "95th percentile time a database executor submission waits before it runs, independent of how long the work itself takes.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(database_executor_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "executor queue wait p95",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "MCP and HTTP latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MCP tool call p95 by tool",
      "description": "95th percentile MCP tool call duration per tool. Compare against the pool panels to separate a slow tool from a saturated database.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(mcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool_name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP request p95 by route",
      "description": "95th percentile HTTP request duration per route template. Routes are templates, so path parameters do not fan out the series.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_target) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{http_target}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Daemon health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Daemon uptime",
      "description": "Seconds since daemon start. Every reset to zero is a restart or an outage; a gap in the series is an outage Prometheus could not scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "daemon_uptime_seconds",
          "legendFormat": "uptime",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "ERROR and CRITICAL log records by surface",
      "description": "Rate of bounded error-level log records per surface and severity. Surfaces are daemon, hooks, mcp, automation, and parser.",
      "datasource": {
        "type": "prometheus",
        "uid": "gobby-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (surface, severity) (rate(logging_records_total{severity=~\"ERROR|CRITICAL\"}[5m]))",
          "legendFormat": "{{surface}} {{severity}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gobby-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(hooks_failed_total[5m]))",
          "legendFormat": "hooks failed",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Logs (requires --profile logs)",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": [
        {
          "id": 13,
          "type": "logs",
          "title": "Daemon and hook log records",
          "description": "Collector-shipped log lines on the same time axis as the metrics above. Requires the loki and otel-collector services from the logs profile.",
          "datasource": {
            "type": "loki",
            "uid": "gobby-loki"
          },
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 36
          },
          "options": {
            "showTime": true,
            "showLabels": false,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "sortOrder": "Descending"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "gobby-loki"
              },
              "editorMode": "code",
              "expr": "{service_name=~\".+\"} | gobby_log_surface=~\"daemon|hooks\"",
              "queryType": "range",
              "refId": "A"
            }
          ]
        }
      ]
    }
  ]
}
