      "id": "synthetic-deadline-handed-to-effects",
      "kind": "rule_pass",
      "provenance": "synthetic",
      "scenario_ids": [
        "S-DEADLINE"
      ],
      "family": null,
      "observer": null,
      "transition": null,
      "posix_only": true,
      "deadline": "expired",
      "rules": [
        {
          "name": "synthetic-deadline-handoff",
          "event": "before_tool",
          "effects": [
            {
              "type": "run_command",
              "command": [
                "{python}",
                "-c",
                "import json, sys, time\nevent = json.load(sys.stdin)\ntime.sleep(float(sys.argv[1]))\nprint(json.dumps({\"additionalContext\": \"synthetic detector saw: \" + event[\"tool_input\"][\"command\"]}))\n",
                "0"
              ],
              "inject_result": true,
              "timeout_seconds": 20
            }
          ]
        }
      ],
      "event": {
        "type": "before_tool",
        "source": "claude",
        "data": {
          "tool_name": "Bash",
          "tool_input": {
            "command": "echo hi"
          }
        },
        "metadata": {}
      },
      "seam_failures": [],
      "expect": {
        "outcome_class": "allow",
        "eager_variable_delta": {
          "project": {
            "name": "Unknown",
            "id": "unknown",
            "path": ""
          },
          "_gobby_feedback_survey_active": false
        },
        "on_receipt_payload": null,
        "effect_log": [
          {
            "event": "before_tool"
          },
          {
            "seam": "rule_definitions",
            "call": "list_by_event",
            "outcome": "ok"
          },
          {
            "effect": "run_command",
            "delivery": "eager",
            "rule": "synthetic-deadline-handoff"
          },
          {
            "run_command_deadline": "expired"
          },
          {
            "write": "rule_eval",
            "call": "record_rule_evaluation",
            "outcome": "ok"
          }
        ],
        "audit_records": [
          {
            "rule": "synthetic-deadline-handoff",
            "result": "allow",
            "event": "before_tool"
          }
        ],
        "response": {}
      }
