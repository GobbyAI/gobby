    {
      "id": "consumer-flag-guard-path-ci",
      "consumer": "FULLMATCH-PATH",
      "driver": "write_paths_match",
      "flag_guard": "case_insensitive",
      "pattern": "./syn/[a-z]+\\.txt",
      "input": "syn/a.txt",
      "control": "syn/A.txt",
      "expect": {
        "input": true,
        "control": false
      }
    },
    {
      "id": "consumer-flag-guard-path-ml",
      "consumer": "FULLMATCH-PATH",
      "driver": "write_paths_match",
      "flag_guard": "multi_line",
      "pattern": "./syn/(?:a\\.txt|a\n^b)",
      "input": "syn/a.txt",
      "control": "syn/a\nb",
      "expect": {
        "input": true,
        "control": false
      }
    },
    {
      "id": "consumer-flag-guard-search-group-ci",
      "consumer": "SEARCH-GROUP",
      "driver": "regex_search_filter",
