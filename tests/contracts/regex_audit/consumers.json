      "id": "consumer-flag-guard-fullmatch-ml",
      "consumer": "FULLMATCH",
      "driver": "attestation_shape_refusal",
      "flag_guard": "multi_line",
      "pattern": "syn|a\n^b",
      "input": "syn",
      "control": "a\nb",
      "definitions": {
        "agent": {
