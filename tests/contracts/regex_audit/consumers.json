      "expect": {
        "input": null,
        "control": "Selected closure rules can never accept this synthetic-kind attestation: task_close rule synthetic-rule-attest needs a reference value matching 'syn-[a-z]{3}', got reference value 'SYN-ABC'. Accepted shape: reference {scheme 'synthetic', value matching 'syn-[a-z]{3}'}."
