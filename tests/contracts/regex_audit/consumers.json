    {
      "id": "consumer-flag-guard-firstline-ci",
      "consumer": "MATCH-GROUPS-FIRSTLINE",
      "driver": "advance_seat",
      "flag_guard": "case_insensitive",
      "pattern": "^SYN (agree|object) ([0-9a-f]{7})$",
      "input": "SYN agree abc1234\nbody",
      "control": "syn agree abc1234\nbody",
      "protocol": {
        "consensus_step": "synthetic-review",
