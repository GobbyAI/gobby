        "input": true,
        "control": false
      }
    },
    {
      "id": "consumer-flag-guard-bool-ml",
      "consumer": "BOOL",
      "driver": "command_patterns_match",
      "flag_guard": "multi_line",
      "pattern": "^synq ",
      "input": "synq go \"",
      "control": "echo a \"\nsynq go",
