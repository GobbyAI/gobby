      "a/b": 1,
      "m~n": 2,
      "k": 3
    },
    "mask": [
      "/a~1b",
      "/m~0n"
    ],
    "expected": {
      "a/b": "@mask@",
      "m~n": "@mask@",
      "k": 3
    }
  },
  {
    "name": "absent_field",
    "input": {
      "a": {
        "b": 1
      }
    },
    "mask": [
      "/a/missing",
      "/nope/deeper",
      "/a/b/c"
    ],
    "expected": {
      "a": {
        "b": 1
      }
    }
  },
  {
