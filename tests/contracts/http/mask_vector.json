            "port": 1
          }
        ]
      },
      "issued_at": 5
    },
    "mask": [
      "/issued_at"
    ],
    "expected": {
      "proof": "@secret@",
      "outer": {
        "dsn": "@secret@",
        "token": "@secret@",
        "keep": "k",
        "list": [
          {
            "api_key": "@secret@",
