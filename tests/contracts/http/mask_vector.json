[
  {
    "name": "nested_object",
    "input": {
      "a": {
        "b": {
          "c": 1,
          "d": 2
        }
      }
    },
    "mask": [
      "/a/b/c"
    ],
    "expected": {
      "a": {
        "b": {
          "c": "@mask@",
          "d": 2
        }
      }
    }
  },
  {
    "name": "array_index",
    "input": {
      "items": [
        {
          "id": 1
        },
        {
          "id": 2
        }
      ]
    },
    "mask": [
      "/items/1/id"
    ],
    "expected": {
      "items": [
        {
          "id": 1
        },
        {
          "id": "@mask@"
        }
      ]
    }
  },
  {
    "name": "escapes",
