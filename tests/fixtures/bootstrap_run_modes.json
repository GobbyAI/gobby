{
    "cases": [
        {
            "name": "uppercase_scheme",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "HTTPS://hub.example"
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "zero_padded_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:0443"
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example:443"
        },
        {
            "name": "empty_host",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://:443"
            },
            "error": "hub_daemon_url must be an http(s) origin with a host"
        },
        {
            "name": "empty_fragment",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example#"
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "empty_query",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example?"
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "local_null_optional_fields",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub_daemon_url": null,
                "hub_cert": null
            },
            "mode": "standalone",
            "hub_daemon_url": null
        },
        {
            "name": "remote_null_hub_url",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": null
            },
            "error": "hub_daemon_url is required for datastore_mode: remote"
        },
        {
            "name": "node_null_hub_cert",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "hub_cert": null
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "standalone",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub_cert": "local.pem"
            },
            "mode": "standalone",
            "hub_daemon_url": null,
            "hub_cert": "local.pem"
        },
        {
            "name": "hub_boolean",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub": true,
                "hub_cert": "hub.pem"
            },
            "mode": "hub",
            "hub_daemon_url": null,
            "hub_cert": "hub.pem"
        },
        {
            "name": "hub_yaml_yes",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub": "yes"
            },
            "mode": "hub",
            "hub_daemon_url": null
        },
        {
            "name": "node_normalized",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://HUB.Example:443/",
                "hub_cert": "node.pem"
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example:443",
            "hub_cert": "node.pem"
        },
        {
            "name": "node_ipv6",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "http://[2001:DB8::1]:60887/"
            },
            "mode": "node",
            "hub_daemon_url": "http://[2001:db8::1]:60887"
        },
        {
            "name": "remote_hub",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub": true,
                "hub_daemon_url": "https://hub.example"
            },
            "error": "hub: true requires datastore_mode: local"
        },
        {
            "name": "invalid_hub",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub": "maybe"
            },
            "error": "hub must be a boolean"
        },
        {
            "name": "invalid_mode",
            "bootstrap": {
                "datastore_mode": "typo"
            },
            "error": "datastore_mode must be one of: local, remote"
        },
        {
            "name": "missing_hub_url",
            "bootstrap": {
                "datastore_mode": "remote"
            },
            "error": "hub_daemon_url is required for datastore_mode: remote"
        },
        {
            "name": "local_hub_url",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub_daemon_url": "https://hub.example"
            },
            "error": "hub_daemon_url is not allowed on a local bootstrap; this process is the owner"
        },
        {
            "name": "own_bind_origin",
            "bootstrap": {
                "datastore_mode": "remote",
                "bind_host": "localhost",
                "daemon_port": 60887,
                "hub_daemon_url": "https://LOCALHOST:60887/"
            },
            "error": "hub_daemon_url must not be this process's own origin"
        },
        {
            "name": "own_daemon_url",
            "bootstrap": {
                "datastore_mode": "remote",
                "daemon_url": "https://node.example:443",
                "hub_daemon_url": "https://NODE.example:443/"
            },
            "error": "hub_daemon_url must not be this process's own origin"
        },
        {
            "name": "hub_userinfo",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://user@hub.example"
            },
            "error": "hub_daemon_url must not include userinfo"
        },
        {
            "name": "hub_query",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example?x=1"
            },
            "error": "hub_daemon_url must not include a query or fragment"
        },
        {
            "name": "hub_path",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example/api"
            },
            "error": "hub_daemon_url path must be empty or /"
        },
        {
            "name": "null_datastore_mode",
            "bootstrap": {
                "datastore_mode": null,
                "files_home": "/tmp/gobby-vector-files"
            },
            "error": "datastore_mode must be one of: local, remote"
        },
        {
            "name": "remote_files_home",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "files_home": "/tmp/gobby-vector-files"
            },
            "error": "files_home is not allowed on a remote bootstrap"
        },
        {
            "name": "remote_non_string_files_home",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "files_home": 42
            },
            "error": "files_home is not allowed on a remote bootstrap"
        },
        {
            "name": "remote_empty_files_home",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "files_home": "   "
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "padded_hub_cert",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "hub_cert": "  hub.pem  "
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example",
            "hub_cert": "  hub.pem  "
        },
        {
            "name": "blank_hub_cert",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "hub_cert": "   "
            },
            "mode": "node",
            "hub_daemon_url": "https://hub.example"
        },
        {
            "name": "non_string_hub_cert",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example",
                "hub_cert": 42
            },
            "error": "hub_cert must be a string"
        },
        {
            "name": "non_string_hub_url",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": 42
            },
            "error": "hub_daemon_url must be a string"
        },
        {
            "name": "local_non_string_hub_url",
            "bootstrap": {
                "files_home": "/tmp/gobby-vector-files",
                "hub_daemon_url": 42
            },
            "error": "hub_daemon_url is not allowed on a local bootstrap; this process is the owner"
        },
        {
            "name": "signed_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:+443"
            },
            "error_type": "ValueError",
            "error": "Port could not be cast to integer value as '+443'"
        },
        {
            "name": "negative_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:-443"
            },
            "error_type": "ValueError",
            "error": "Port could not be cast to integer value as '-443'"
        },
        {
            "name": "non_digit_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:44x"
            },
            "error_type": "ValueError",
            "error": "Port could not be cast to integer value as '44x'"
        },
        {
            "name": "unicode_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:٤٤٣"
            },
            "error_type": "ValueError",
            "error": "Port could not be cast to integer value as '٤٤٣'"
        },
        {
            "name": "out_of_range_port",
            "bootstrap": {
                "datastore_mode": "remote",
                "hub_daemon_url": "https://hub.example:65536"
            },
            "error_type": "ValueError",
            "error": "Port out of range 0-65535"
        }
    ]
}
