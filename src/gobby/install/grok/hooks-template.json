{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "gobby-session-start",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=session_start",
            "timeout": 45
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "gobby-session-end",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=session_end",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "gobby-user-prompt-submit",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=user_prompt_submit",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "gobby-pre-tool-use",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=pre_tool_use",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
