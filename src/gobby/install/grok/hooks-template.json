    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "name": "gobby-pre-compact",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=pre_compact",
            "timeout": 45
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "name": "gobby-post-compact",
            "type": "command",
            "command": "ghook --gobby-owned --cli=grok --type=post_compact",
            "timeout": 45
          }
