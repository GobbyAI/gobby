# Version: 1.0.0
[Unit]
Description=Gobby independent fleet health watcher
After=network.target

[Service]
Type=simple
ExecStart={{ gdaemon_executable|systemd_quote }} fleet-watch{% if fleet_project_id %} --project-id {{ fleet_project_id }}{% endif %} --logs-dir {{ fleet_logs_dir|systemd_quote }}

Environment={{ ('HOME=' + home_dir)|systemd_quote }}
Environment={{ ('PATH=' + path_env)|systemd_quote }}
Environment={{ ('GOBBY_HOME=' + (gobby_home if gobby_home else home_dir + '/.gobby'))|systemd_quote }}
Restart=always
RestartSec=10
StandardOutput={{ ('append:' + fleet_log_file)|systemd_quote }}
StandardError={{ ('append:' + fleet_log_file)|systemd_quote }}

[Install]
WantedBy=default.target
