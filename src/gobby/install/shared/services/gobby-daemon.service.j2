[Unit]
Description=Gobby Daemon - fleet management for AI coding agents
After=network.target

[Service]
Type=simple
ExecStart={{ gdaemon_executable|systemd_quote }} serve

WorkingDirectory={{ working_directory }}
Environment={{ ("HOME=" + home_dir)|systemd_quote }}
Environment={{ ("PATH=" + path_env)|systemd_quote }}
Environment={{ ("GOBBY_BACKEND_COMMAND=" + backend_command)|systemd_quote }}
Environment=GOBBY_SERVICE_LAUNCH=1
{% set nonce_home = gobby_home if gobby_home else home_dir + "/.gobby" %}
Environment={{ ("GOBBY_SERVICE_NONCE=" + nonce_home + "/gobby.pid.service-nonce")|systemd_quote }}
{% if gobby_home %}
Environment=GOBBY_HOME={{ gobby_home }}
{% endif %}

Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

StandardOutput=append:{{ runtime_log_file }}
StandardError=append:{{ runtime_log_file }}

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.gobby

[Install]
WantedBy=default.target
