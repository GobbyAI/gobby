@echo off
setlocal DisableDelayedExpansion
set "PATH={{ path_env }}"
set "HOME={{ home_dir }}"
set GOBBY_BACKEND_COMMAND={{ backend_command|cmd_env }}
set "GOBBY_SERVICE_LAUNCH=1"
{% set nonce_home = gobby_home if gobby_home else home_dir + "\\.gobby" %}
set "GOBBY_SERVICE_NONCE={{ nonce_home }}\gobby.pid.service-nonce"
{% if gobby_home %}
set "GOBBY_HOME={{ gobby_home }}"
{% endif %}
"{{ gdaemon_executable }}" serve >> "{{ runtime_log_file }}" 2>&1
