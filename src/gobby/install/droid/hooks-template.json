{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "__GOBBY_HOOK_COMMAND__",
          "timeout": 120
          }
        ]
      }
    ]
  }
}
