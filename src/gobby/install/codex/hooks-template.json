{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=SessionStart",
          "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghook --gobby-owned --cli=codex --type=SubagentStart",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=UserPromptSubmit",
          "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=PreToolUse",
          "timeout": 120
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=PermissionRequest",
          "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=PostToolUse",
          "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=PreCompact",
          "timeout": 120
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=PostCompact",
          "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghook --gobby-owned --cli=codex --type=SubagentStop",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "ghook --gobby-owned --cli=codex --type=Stop",
          "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghook --gobby-owned --cli=codex --type=SessionEnd --enqueue-only",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
