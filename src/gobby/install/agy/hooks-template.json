            "timeout": 30000
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "hooks": [
          {
            "name": "gobby-post-invocation",
            "type": "command",
            "command": "__GOBBY_HOOK_COMMAND__",
            "timeout": 30000
          }
        ]
      }
