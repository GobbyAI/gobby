{
  "gobby": {
    "PreInvocation": [
      {
        "name": "gobby-pre-invocation",
        "type": "command",
        "command": "__GOBBY_HOOK_COMMAND__",
        "timeout": 45
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "gobby-pre-tool-use",
            "type": "command",
            "command": "__GOBBY_HOOK_COMMAND__",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "gobby-post-tool-use",
            "type": "command",
            "command": "__GOBBY_HOOK_COMMAND__",
            "timeout": 45
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "name": "gobby-post-invocation",
        "type": "command",
        "command": "__GOBBY_HOOK_COMMAND__",
        "timeout": 45
      }
    ],
    "Stop": [
      {
        "name": "gobby-stop",
        "type": "command",
        "command": "__GOBBY_HOOK_COMMAND__",
        "timeout": 45
      }
    ]
  }
}
