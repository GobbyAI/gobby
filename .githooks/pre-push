#!/bin/sh
# Publish the project wiki vault to the `wiki` branch whenever `main` is pushed.
#
# The vault is resolved like gobby_core::vault / gobby.utils.wiki_vault: the
# first of `wiki/`, `gobby-wiki/`, `gobby-wiki-NNN/` carrying the
# `_gwiki/scope.json` marker. It is gitignored on active branches and checked
# out as a sibling worktree on the `wiki` branch. This hook mirrors the vault
# CONTENTS into that worktree root (same flat layout as the daemon's
# _mirror_wiki_vault publisher), commits, and pushes origin/wiki. It is
# best-effort: failures are reported but never block the push to main (exit 0).
#
# One-time setup per clone:
#   git worktree add --orphan -b wiki ../<repo>-wiki
#
# If this clone already uses a generated .git/hooks/pre-push, keep it and chain
# this script from there instead of replacing core.hooksPath.
set -u

repo_root=$(git rev-parse --show-toplevel) || exit 0
wt="$repo_root/../$(basename "$repo_root")-wiki"

resolve_vault() {
	for candidate in "$repo_root/wiki" "$repo_root/gobby-wiki" "$repo_root"/gobby-wiki-[0-9][0-9][0-9]; do
		if [ -f "$candidate/_gwiki/scope.json" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

publish() {
	if [ ! -e "$wt/.git" ]; then
		echo "pre-push: wiki worktree not found at $wt; skipping vault publish" >&2
		echo "pre-push: create it with 'git worktree add --orphan -b wiki $wt'" >&2
		return 0
	fi
	vault=$(resolve_vault) || {
		echo "pre-push: no initialized wiki vault to publish; skipping" >&2
		return 0
	}
	rsync -a --delete --exclude '.git' "$vault/" "$wt/" || return 0
	git -C "$wt" add -A -f .
	if git -C "$wt" diff --cached --quiet; then
		echo "pre-push: vault unchanged; nothing to publish" >&2
		return 0
	fi
	git -C "$wt" commit -q -m "vault: sync from $(git -C "$repo_root" rev-parse --short HEAD)"
	git -C "$wt" push -q origin HEAD:wiki || echo "pre-push: vault publish push failed (non-fatal)" >&2
}

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref being pushed
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/main) publish ;;
	esac
done

exit 0
