{
  "name": "gobby-annotate-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages e2e *.ts *.mjs safari/test.mjs",
    "format:check": "prettier --check packages e2e *.json *.ts *.mjs docs README.md safari/test.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:safari": "node safari/test.mjs",
    "build:mcp": "npm run build --workspace gobby-annotate",
    "build:extension": "npm run build --workspace @gobby/annotate-extension"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
