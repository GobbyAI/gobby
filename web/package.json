    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "node scripts/patch-jsx-a11y-minimatch.mjs && eslint --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "patch:tailwind-node-dep0205": "node scripts/patch-tailwind-node-dep0205.mjs",
    "postinstall": "node scripts/patch-tailwind-node-dep0205.mjs && node scripts/patch-jsx-a11y-minimatch.mjs && node scripts/copy-vad-assets.cjs && node scripts/copy-ghostty-wasm.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
