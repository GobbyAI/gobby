    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.3",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.4.1",
    "three": ">=0.118.0 <1",
    "three-spritetext": "^1.10.0",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "@babel/core": ">=7.29.6 <8",
    "flatted": ">=3.4.2",
    "lodash-es": ">=4.18.0",
    "minimatch": "10.2.5",
    "picomatch": ">=4.0.4",
